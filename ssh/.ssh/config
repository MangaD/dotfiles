# =============================================================================
# Global configuration
# =============================================================================

# Settings under "Host *" apply to every SSH connection unless overridden by
# a more specific Host entry.
Host *

    # Send a message to the server periodically while the connection is idle.
    #
    # This can help prevent SSH connections from being dropped by routers,
    # firewalls, or other network equipment after long periods of inactivity.
    #
    # The value is the number of seconds between messages.
    ServerAliveInterval 60

    # Disconnect after three consecutive server-alive messages receive no
    # response.
    #
    # Together with ServerAliveInterval=60, SSH will consider the connection
    # lost after roughly three minutes without a response from the server.
    ServerAliveCountMax 3

    # Add private keys used for authentication to the running SSH agent.
    #
    # This can avoid repeatedly entering a key's passphrase during the same
    # login session.
    AddKeysToAgent yes


# =============================================================================
# Local configuration
# =============================================================================

# Load machine-specific or private SSH configuration when present.
#
# This file is intentionally not stored in the dotfiles repository. It can
# contain hostnames, IP addresses, usernames, ports, identity-file paths, and
# other details that should remain local.
#
# Example ~/.ssh/config.local:
#
#     Host server
#         HostName 192.168.1.10
#         User david
#         Port 22
#         IdentityFile ~/.ssh/id_ed25519
#
# The connection can then be opened simply with:
#
#     ssh server
Include ~/.ssh/config.local
